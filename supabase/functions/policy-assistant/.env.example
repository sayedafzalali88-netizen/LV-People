# Secrets and settings of the server function "policy-assistant".
# Do NOT put real keys in this file or anywhere in the repository.
# Set them in Supabase > Edge Functions > Secrets (or: supabase secrets set NAME=value).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are given to the function by Supabase automatically.

# --- required ---
ANTHROPIC_API_KEY=            # Claude API key (console.anthropic.com > API keys)
VOYAGE_API_KEY=               # Voyage AI key for embeddings (dash.voyageai.com > API keys)

# --- models (defaults shown) ---
POLICY_LLM_MODEL=claude-haiku-5-5      # writes the answers
POLICY_OCR_MODEL=claude-haiku-5-5      # reads scanned PDF pages
EMBEDDING_PROVIDER=voyage              # voyage | openai  (openai needs OPENAI_API_KEY)
EMBEDDING_MODEL=voyage-3.5             # voyage-3.5 (multilingual); for openai: text-embedding-3-small
# OPENAI_API_KEY=                      # only if EMBEDDING_PROVIDER=openai

# --- answer rules ---
POLICY_MIN_SCORE=0.45         # similarity threshold: below this the AI is NOT called and the "jaankari uplabdh nahi" answer is given
POLICY_TOP_K=5                # policy parts sent to the AI (4 to 6)
POLICY_QUERY_REWRITE=on       # on | off: also search with an English version of a Hindi/Hinglish question (search only, never the answer)
POLICY_OCR=on                 # on | off: read scanned PDF pages with OCR

# --- optional ---
# POLICY_CRON_SECRET=          # not needed: server/policy_assistant.sql makes it in the Vault; set only to override

# --- limits ---
POLICY_RATE_PER_MIN=5         # questions per employee per minute
POLICY_MONTHLY_CAP=3000       # questions per company per month (0 = no limit)
POLICY_MAX_FILE_MB=20
POLICY_MAX_PAGES=300
POLICY_OCR_BATCH=4            # scanned pages per OCR call
POLICY_ALLOWED_ORIGINS=*      # or: https://lv-people.pages.dev
