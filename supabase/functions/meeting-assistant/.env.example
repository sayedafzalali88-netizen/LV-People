# Secrets and settings of the server function "meeting-assistant" (Client Meetings app).
# Do NOT put real keys in this file or anywhere in the repository.
# Set them in Supabase > Edge Functions > Secrets (or: supabase secrets set NAME=value).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are given to the function by Supabase automatically.

# --- required ---
ANTHROPIC_API_KEY=            # Claude API key (already set if the HR Assistant is in use: secrets are shared by all functions)
ELEVENLABS_API_KEY=           # ElevenLabs key for speech to text (elevenlabs.io > Developers > API keys; needs the Speech to Text permission)

# --- models (defaults shown) ---
MEETING_LLM_MODEL=claude-opus-5-5   # writes the summary and the strategy
MEETING_LLM_EFFORT=high             # low | medium | high | xhigh | max (higher = deeper plan, slower, costlier)
MEETING_STT_MODEL=scribe_v2         # ElevenLabs speech-to-text model (scribe_v1 also works)

# --- optional ---
MEETING_ALLOWED_ORIGINS=*           # or: https://lv-people.pages.dev
